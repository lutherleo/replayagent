# replayagent CLI: SQLite database path (default ./replayagent.db)
REPLAYAGENT_DB=replayagent.db

# Crash injection, for tests and demos only: point[@n][,point[@n]...]. Leave unset.
# REPLAYAGENT_CRASH=after_activity_completed@5
# REPLAYAGENT_CRASH_MODE=exit

# Research example: provider is "fake" (default) or "ollama"
RESEARCH_PROVIDER=fake
# Model used when RESEARCH_PROVIDER=ollama
RESEARCH_MODEL=llama3.1:8b
# Where reports and the publish ledger are written
RESEARCH_OUT_DIR=research-out
# Optional JSONL log of fake model calls
# RESEARCH_FAKE_LOG=model-calls.jsonl
OLLAMA_HOST=http://127.0.0.1:11434
